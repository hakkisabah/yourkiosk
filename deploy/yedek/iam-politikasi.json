{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SurumOku",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::yourkiosk-veri/kiosk/lastSystemData.json",
        "arn:aws:s3:::yourkiosk-veri/kiosk/lastupdate.json"
      ]
    },
    {
      "Sid": "GeriDonmeYaz",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::yourkiosk-veri/kiosk/lastSystemData.json",
        "arn:aws:s3:::yourkiosk-veri/kiosk/lastupdate.json"
      ]
    },
    {
      "Sid": "SurumListele",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucketVersions",
        "s3:GetBucketVersioning"
      ],
      "Resource": "arn:aws:s3:::yourkiosk-veri"
    }
  ]
}
