{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NesneOkuYaz",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:GetObjectTagging",
        "s3:PutObjectTagging"
      ],
      "Resource": "arn:aws:s3:::yourkiosk-veri/kiosk/*"
    },
    {
      "Sid": "SurumListele",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::yourkiosk-veri"
    }
  ]
}
