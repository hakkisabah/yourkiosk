# Gerekli ayarlar — bu dosyayı `.env.local` olarak kopyalayıp doldurun.
#   cp .env.ornek .env.local
# .env.local sürüm kontrolüne GİRMEZ (bkz. .gitignore).
#
# İKİ MOD vardır (maliyet/gerekçe: MAALIYET.md):
#   cognito (varsayılan): Cognito User Pool + Identity Pool → geçici AWS anahtarı
#                         (ücretsiz kota: 10.000 MAU/ay, süresiz)
#   lambda              : Cognito YOK → Lambda + HttpOnly cookie + presigned S3 URL
#                         (Lambda kalıcı ücretsiz kota)

VITE_AUTH_MODU=cognito

# ---- ortak ----
VITE_BUCKET=yourkiosk-veri
VITE_PREFIX=kiosk/

# ---- yalnızca cognito modu ----
VITE_AWS_REGION=eu-central-1
VITE_USER_POOL_ID=eu-central-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_IDENTITY_POOL_ID=eu-central-1:11111111-2222-3333-4444-555555555555

# ---- yalnızca lambda modu ----
# Lambda Function URL (sonunda / OLMADAN)
VITE_API_URL=https://abcdefghij.lambda-url.eu-central-1.on.aws

# ---- MQTT anlık tetikleme (isteğe bağlı; sır DEĞİL) ----
# PAROLA BURAYA YAZILMAZ: VITE_* değerleri derleme anında JS paketine gömülür ve panel paketi
# CloudFront'tan herkese açık indirilir. Yayın parolası panelde oturumda bir kez sorulur.
# VITE_MQTT_URL=wss://broker.example:8084/mqtt
# VITE_MQTT_KONU=yourkiosk/yayin
# VITE_MQTT_KULLANICI=panel
