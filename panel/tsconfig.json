{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "env.d.ts",
    "vite.config.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue"
  ],
  // NOT: test dosyaları ÜRETİM derlemesinde tip denetlenmez. Aksi hâlde test-only bağımlılıklar
  // (@vue/test-utils, jsdom) kurulu değilse `npm run build` kırılır — 24.10'da yaşandı.
  // Testlerin tip kontrolü: `npm run typecheck:test` (tsconfig.test.json).
  "exclude": ["src/**/*.test.ts", "src/**/__tests__/**"]
}
