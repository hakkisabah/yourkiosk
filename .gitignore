# yourkiosk deposu — kök düzeyinde yok sayılacaklar
# (kiosk/ ve panel/ içinde ayrıca kendi .gitignore dosyaları var)

# --- kiosk: yerel ortam ve üretilen veri ---
kiosk/.venv/
kiosk/.qt-libs/
kiosk/.karantina/
kiosk/.cache/
kiosk/_arsiv/
kiosk/kiosk.log
kiosk/ayarlar.json
kiosk/kapsam-ayarlari.json
kiosk/makinebilgileri.json
kiosk/onbellek/
# Araçların geçici önbellek klasörleri (canli_akis_test.py, yerel probe'lar)
kiosk/*-test-onbellek/
kiosk/lastSystemData.json
kiosk/lastupdate.json
kiosk/match.json
kiosk/data/id_eslesme.json

# --- tarayıcı (Chromium kiosk) gösterim modu ---
kiosk/.tarayici-profil/
web/node_modules/
# Sondaki `/` YOK: `web/dist/` yalnız DİZİNİ yok sayar; adı `dist` olan bir dosya/sembolik bağ
# kuralı atlar (26 Ekim: depoya mutlak yollu `web/dist` sembolik bağı böyle sızdı).
web/dist

# --- panel: bağımlılıklar, derleme, ortam ---
panel/node_modules/
# Aynı sınıf: `panel/dist/` dizine özeldi → adı `dist` olan dosya/bağ kaçıyordu.
panel/dist
panel/.env
panel/.env.*
!panel/.env.ornek
# `npx` depo kökünde düğüm_modules oluşturabiliyor (çalışma ağacı kirlenmesin)
node_modules/
panel/coverage/

# --- düzenleyici / işletim sistemi ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# --- derleyici/yorumlayıcı artıkları (her dil, her alt klasör) ---
# `panel/lambda/tests/__pycache__/` gibi derin klasörler için kök düzeyinde kural şart:
# panel/.gitignore yalnız `lambda/__pycache__/` diyordu ve `lambda/tests/__pycache__/` kaçıyordu.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
web/.vite/
panel/.vite/
.karantina/

# --- otomasyon: üretilen geçici dosyalar ---
karar-ornek.json
karar.json
otomasyon-paket.json
komut-gonderilecek.json
