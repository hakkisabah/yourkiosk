{
  "name": "yourkiosk-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "yourkiosk tarayıcı (Chromium kiosk) gösterim modu — Qt arayüzüyle aynı görünüm, davranış ve veri kuralları",
  "scripts": {
    "dev": "NODE_ENV=development vite",
