#!/bin/bash
# DSH bwrap runner — i5/i3 güvenlik incelemesi (salt-okunur ajan).
#
# Ajanın gördüğü dünya: repo (ro) + PAKET_DIR (ro) + KARAR_DIR (rw) + boş $HOME + /tmp.
# Ev, sırlar, Docker/socket, user systemd ve ağ görünmez. FD ile dizin devri YAPILMAZ:
# açık dizin fd'si sandbox içinden /proc/self/fd üzerinden ana makineye çıkış verir.
# Kaynaklar (repo/paket/karar) gölge $HOME bind edildikten SONRA, mutlak host yoluyla
# bağlanır; bwrap kaynağı host kökünden çözer.
set -u

if ! command -v bwrap >/dev/null 2>&1; then
  echo "dsh-bwrap-kiosk: bwrap bulunamadı" >&2
  exit 127
fi

args=("$@")
yeni=()
ayrac=0

for a in "${args[@]}"; do
  if [ "$a" = "--" ] && [ "$ayrac" -eq 0 ]; then
    HOME_REAL="$(realpath -e "$HOME" 2>/dev/null || true)"
    [ -n "$HOME_REAL" ] || { echo "dsh-bwrap-kiosk: HOME çözülemedi" >&2; exit 2; }

    DEPO_ISARET="$HOME/.local/state/yourkiosk-otomasyon/depo-yolu"
    DEPO_GIRDI=""
    [ -r "$DEPO_ISARET" ] && DEPO_GIRDI="$(cat "$DEPO_ISARET" 2>/dev/null || true)"
    DEPO_REAL="$(realpath -e "$DEPO_GIRDI" 2>/dev/null || true)"
    gecerli=1
    [ -n "$DEPO_REAL" ] && [ -d "$DEPO_REAL/.git" ] || gecerli=0
    [ "$DEPO_REAL" = "$HOME_REAL" ] && gecerli=0
    [ "$DEPO_REAL" = "/" ] && gecerli=0
    case "$HOME_REAL" in "$DEPO_REAL"/*) gecerli=0 ;; esac
    [ "$gecerli" -eq 1 ] || { echo "dsh-bwrap-kiosk: geçersiz depo yolu" >&2; exit 2; }

    KARAR_GIRDI="${DSH_KARAR_DIR:-${KARAR_DIR:-}}"
    ISARET="$HOME/.local/state/yourkiosk-otomasyon/karar-yolu"
    if [ -z "$KARAR_GIRDI" ] && [ -r "$ISARET" ]; then
      KARAR_GIRDI="$(cat "$ISARET" 2>/dev/null || true)"
    fi
    [ -n "$KARAR_GIRDI" ] || KARAR_GIRDI="$HOME/.local/state/yourkiosk-otomasyon/karar"
    KARAR_REAL="$(realpath -e "$KARAR_GIRDI" 2>/dev/null || true)"
    [ -n "$KARAR_REAL" ] && [ -d "$KARAR_REAL" ] || { echo "dsh-bwrap-kiosk: karar dizini yok" >&2; exit 2; }

    PAKET_GIRDI="${PAKET_DIR:-}"
    PAKET_ISARET="$HOME/.local/state/yourkiosk-otomasyon/paket-yolu"
    if [ -z "$PAKET_GIRDI" ] && [ -r "$PAKET_ISARET" ]; then
      PAKET_GIRDI="$(cat "$PAKET_ISARET" 2>/dev/null || true)"
    fi
    PAKET_REAL="$(realpath -e "$PAKET_GIRDI" 2>/dev/null || true)"

    SHADOW_DIR="${DSH_SHADOW_DIR:-/var/tmp}"
    [ -d "$SHADOW_DIR" ] || SHADOW_DIR=/var/tmp
    SHADOW="$(mktemp -d "$SHADOW_DIR/dsh-home.XXXXXX" 2>/dev/null)" || {
      echo "dsh-bwrap-kiosk: gölge ev açılamadı" >&2; exit 2; }
    trap 'rm -rf "$SHADOW"' EXIT

    rel_yol() {
      case "$1" in
        "$HOME_REAL"/*) printf '%s' "${1#"$HOME_REAL"/}" ;;
        *) printf '%s' "" ;;
      esac
    }
    hedef_yol() {
      rel="$(rel_yol "$1")"
      if [ -n "$rel" ]; then printf '%s/%s' "$HOME_REAL" "$rel"; else printf '%s' "$1"; fi
    }
    REL_DEPO="$(rel_yol "$DEPO_REAL")"
    REL_KARAR="$(rel_yol "$KARAR_REAL")"
    REL_PAKET=""
    [ -n "$PAKET_REAL" ] && REL_PAKET="$(rel_yol "$PAKET_REAL")"

    [ -n "$REL_DEPO" ] && mkdir -p "$SHADOW/$REL_DEPO"
    [ -n "$REL_KARAR" ] && mkdir -p "$SHADOW/$REL_KARAR"
    [ -n "$REL_PAKET" ] && mkdir -p "$SHADOW/$REL_PAKET"

    # 1) Ev gölgeyle değiştirilir. 2) Kaynaklar host'tan mutlak yolla geri bağlanır.
    yeni+=(--ro-bind "$SHADOW" "$HOME_REAL")
    yeni+=(--ro-bind "$DEPO_REAL" "$(hedef_yol "$DEPO_REAL")")
    yeni+=(--bind "$KARAR_REAL" "$(hedef_yol "$KARAR_REAL")")
    [ -n "$PAKET_REAL" ] && [ -d "$PAKET_REAL" ] && yeni+=(--ro-bind "$PAKET_REAL" "$(hedef_yol "$PAKET_REAL")")

    # /run tamamen maskelenir: Docker/containerd/podman, user systemd ve D-Bus.
    yeni+=(--tmpfs /tmp --tmpfs /run --unshare-net --)
    ayrac=1
  else
    yeni+=("$a")
  fi
done

if [ "$ayrac" -eq 0 ]; then
  echo "dsh-bwrap-kiosk: eksik -- ayracı" >&2
  exit 2
fi

bwrap "${yeni[@]}"
exit $?
