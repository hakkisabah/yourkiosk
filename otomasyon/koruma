#!/bin/sh
# Sarmalayıcı — `sh otomasyon/koruma …` ya da `./otomasyon/koruma …` (doğru yorumlayıcıyı seçer).
# Python dosyasını doğrudan `sh` ile çalıştırmak "line 2: main: command not found" hatası verir.
BETIK_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
exec python3 "$BETIK_DIR/betik/koruma-kur.py" "$@"
