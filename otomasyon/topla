#!/bin/sh
# Sarmalayıcı — `sh otomasyon/topla …` ya da `./otomasyon/topla …` (doğru yorumlayıcıyı seçer).
# Python dosyasını doğrudan `sh` ile çalıştırmak "line 2: main: command not found" hatası verir.
BETIK_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
exec python3 "$BETIK_DIR/betik/topla.py" "$@"
