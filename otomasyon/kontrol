#!/bin/sh
# Sarmalayıcı — `sh otomasyon/kontrol …` ya da `./otomasyon/kontrol …` (doğru yorumlayıcıyı seçer).
# Python dosyasını doğrudan `sh` ile çalıştırmak "line 2: main: command not found" hatası verir.
BETIK_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
exec python3 "$BETIK_DIR/betik/ortam-kontrol.py" "$@"
